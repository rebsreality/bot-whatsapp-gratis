# Copie para .env (local) ou cadastre no painel do Render/Koyeb.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta for Developers — WhatsApp > Configuração da API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Senha que VOCÊ inventa e repete no campo "Verificar token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=troque-por-uma-senha-sua
# Opcional (recomendado): Configurações do App > Básico > Chave secreta do aplicativo
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# Memória: quantas mensagens lembrar por cliente
HISTORY_LIMIT=8
SQLITE_PATH=./data/historico.db
# Opcional (recomendado em produção): https://console.upstash.com — Redis > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PROMPT_FILE=./PROMPT_ATENDIMENTO.md
PORT=3000
